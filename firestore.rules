rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Helper Functions
    // ===============================================================
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isDocOwner() {
      return isAuthenticated() && request.auth.uid == resource.data.authorUid;
    }

    function uidUnchanged() {
      return !('uid' in request.resource.data) || request.resource.data.uid == request.auth.uid;
    }

    function uidNotModified() {
      return !('uid' in request.resource.data) || request.resource.data.uid == resource.data.uid;
    }

    function hasRequiredFields(fields) {
      return request.resource.data.keys().hasAll(fields);
    }

    function hasOnlyAllowedFields(fields) {
      return request.resource.data.keys().hasOnly(fields);
    }

    // ===============================================================
    // Domain Validators
    // ===============================================================

    function isValidUser(data) {
      return hasOnlyAllowedFields(['uid', 'username', 'displayName', 'photoURL', 'createdAt']) &&
             data.uid is string && data.uid.size() > 0 && data.uid.size() < 128 &&
             data.username is string && data.username.size() > 0 && data.username.size() < 50 &&
             (!('displayName' in data) || (data.displayName is string && data.displayName.size() < 100)) &&
             (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() < 1000)) &&
             data.createdAt is timestamp;
    }

    function isValidPost(data) {
      return hasOnlyAllowedFields(['id', 'authorUid', 'authorUsername', 'authorPhotoURL', 'imageUrl', 'caption', 'likesCount', 'createdAt']) &&
             data.id is string && data.id.size() > 0 && data.id.size() < 128 &&
             data.authorUid is string && data.authorUid == request.auth.uid &&
             data.authorUsername is string && data.authorUsername.size() > 0 && data.authorUsername.size() < 50 &&
             (!('authorPhotoURL' in data) || (data.authorPhotoURL is string && data.authorPhotoURL.size() < 1000)) &&
             data.imageUrl is string && data.imageUrl.size() > 0 && data.imageUrl.size() < 1000000 &&
             (!('caption' in data) || (data.caption is string && data.caption.size() < 2200)) &&
             data.likesCount is number && data.likesCount >= 0 &&
             data.createdAt is timestamp;
    }

    function isValidLike(data) {
      return hasOnlyAllowedFields(['postId', 'userId', 'createdAt']) &&
             data.postId is string && data.postId.size() > 0 && data.postId.size() < 128 &&
             data.userId is string && data.userId == request.auth.uid &&
             data.createdAt is timestamp;
    }

    function isValidComment(data) {
      return hasOnlyAllowedFields(['id', 'postId', 'authorUid', 'authorUsername', 'text', 'createdAt']) &&
             (!('id' in data) || (data.id is string && data.id.size() > 0 && data.id.size() < 128)) &&
             data.postId is string && data.postId.size() > 0 && data.postId.size() < 128 &&
             data.authorUid is string && data.authorUid == request.auth.uid &&
             data.authorUsername is string && data.authorUsername.size() > 0 && data.authorUsername.size() < 50 &&
             data.text is string && data.text.size() > 0 && data.text.size() < 500 &&
             data.createdAt is timestamp;
    }

    function isValidCounterUpdate(docId) {
      let diff = request.resource.data.diff(resource.data);
      return diff.affectedKeys().hasOnly(['likesCount']) &&
             math.abs(request.resource.data.likesCount - resource.data.likesCount) == 1 &&
             (
               (request.resource.data.likesCount > resource.data.likesCount &&
                !exists(/databases/$(database)/documents/likes/$(request.auth.uid + '_' + docId)) &&
                getAfter(/databases/$(database)/documents/likes/$(request.auth.uid + '_' + docId)) != null) ||
               (request.resource.data.likesCount < resource.data.likesCount &&
                exists(/databases/$(database)/documents/likes/$(request.auth.uid + '_' + docId)) &&
                getAfter(/databases/$(database)/documents/likes/$(request.auth.uid + '_' + docId)) == null)
             );
    }

    // ===============================================================
    // Collections
    // ===============================================================

    match /users/{userId} {
      // Public profiles are readable by anyone authenticated
      allow read: if isAuthenticated();
      allow create: if isOwner(userId) && isValidUser(request.resource.data) && uidUnchanged();
      allow update: if isOwner(userId) && isValidUser(request.resource.data) && uidNotModified() && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if false;
    }

    match /posts/{postId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && isValidPost(request.resource.data) && request.resource.data.likesCount == 0;
      allow update: if isAuthenticated() && (
        (isDocOwner() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['caption', 'authorPhotoURL', 'authorUsername']) && request.resource.data.caption is string && request.resource.data.caption.size() < 2200) ||
        isValidCounterUpdate(postId)
      );
      allow delete: if isDocOwner();
    }

    match /likes/{likeId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && likeId == request.auth.uid + '_' + request.resource.data.postId && isValidLike(request.resource.data);
      allow delete: if isAuthenticated() && likeId == request.auth.uid + '_' + resource.data.postId;
      allow update: if false;
    }

    match /comments/{commentId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && isValidComment(request.resource.data);
      allow update: if false;
      allow delete: if isDocOwner();
    }
  }
}
